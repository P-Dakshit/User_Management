<!DOCTYPE html>
<html>
<head>
  <title>User List</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    #searchInput {
      margin-bottom: 20px;
    }
    img.user-photo {
      width: 60px;
      height: 60px;
      object-fit: cover;
      border-radius: 50%;
    }
    th.sortable {
      cursor: pointer;
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <h2 class="mb-4">Registered Users</h2>

    <!-- Search bar -->
    <input type="text" id="searchInput" class="form-control" placeholder="Search by name, email or phone">

    <table class="table table-bordered table-hover mt-3" id="userTable">
      <thead class="table-dark">
        <tr>
          <th>Photo</th>
          <th class="sortable" onclick="sortTable('name')">Name</th>
          <th class="sortable" onclick="sortTable('email')">Email</th>
          <th class="sortable" onclick="sortTable('phone')">Phone</th>
          <th>Address</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="userBody">
        <% users.forEach((user, index) => { %>
          <tr class="user-row" data-name="<%= user.first_name + ' ' + user.last_name %>" data-email="<%= user.email %>" data-phone="<%= user.phone %>">
            <td><img src="/Upload/<%= user.photo %>" class="user-photo" alt="User Photo"></td>
            <td><%= user.first_name %> <%= user.last_name %></td>
            <td><%= user.email %></td>
            <td><%= user.phone %></td>
            <td><%= user.address %></td>
            <td><%= user.role %></td>
            <td>
              <a href="/dashboard/user/<%= user.email %>" class="btn btn-sm btn-info">View</a>
              <form action="/admin/user/<%= user.email %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <!-- Pagination controls -->
    <nav>
      <ul class="pagination justify-content-center" id="pagination"></ul>
    </nav>
  </div>

  <!-- JS for Pagination, Search, Sorting -->
  <script>
    const searchInput = document.getElementById('searchInput');
    const allRows = Array.from(document.querySelectorAll('.user-row'));
    const rowsPerPage = 10;
    const pagination = document.getElementById('pagination');

    let currentFilteredRows = [...allRows];

    function showPage(page, list) {
      const start = (page - 1) * rowsPerPage;
      const end = start + rowsPerPage;

      allRows.forEach(row => row.style.display = 'none');
      list.slice(start, end).forEach(row => row.style.display = '');
    }

    function setupPagination(list) {
      pagination.innerHTML = '';
      const totalPages = Math.ceil(list.length / rowsPerPage);

      for (let i = 1; i <= totalPages; i++) {
        const li = document.createElement('li');
        li.className = 'page-item';
        li.innerHTML = `<button class="page-link">${i}</button>`;
        li.addEventListener('click', () => {
          document.querySelectorAll('.page-item').forEach(item => item.classList.remove('active'));
          li.classList.add('active');
          showPage(i, list);
        });
        pagination.appendChild(li);
      }

      if (pagination.firstChild) pagination.firstChild.classList.add('active');
      showPage(1, list);
    }

    searchInput.addEventListener('input', function () {
      const keyword = this.value.toLowerCase();
      currentFilteredRows = allRows.filter(row => {
        const name = row.dataset.name.toLowerCase();
        const email = row.dataset.email.toLowerCase();
        const phone = row.dataset.phone.toLowerCase();
        return name.includes(keyword) || email.includes(keyword) || phone.includes(keyword);
      });

      setupPagination(currentFilteredRows);
    });

    function sortTable(field) {
      const fieldMap = {
        name: 'name',
        email: 'email',
        phone: 'phone'
      };

      const dataField = 'data-' + fieldMap[field];

      currentFilteredRows.sort((a, b) => {
        const aText = a.getAttribute(dataField).toLowerCase();
        const bText = b.getAttribute(dataField).toLowerCase();
        return aText.localeCompare(bText);
      });

      const tbody = document.getElementById('userBody');
      tbody.innerHTML = '';
      currentFilteredRows.forEach(row => tbody.appendChild(row));

      setupPagination(currentFilteredRows);
    }

    // Initialize
    setupPagination(currentFilteredRows);
  </script>
</body>
</html>
